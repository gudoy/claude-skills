# Copier ce fichier en `.env` et renseigner les valeurs réelles.
# `.env` est ignoré par git — ne JAMAIS committer de valeur réelle ici.

# --- Notion -------------------------------------------------------------
# Token d'intégration interne Notion (SECRET).
# Créé sur https://www.notion.so/profile/integrations, puis connecté à chaque
# base via le menu "•••" → Connexions.
NOTION_API_KEY=
NOTION_TOKEN=            # alias utilisé par le script add_candidature.py

# IDs des bases Notion (32 caractères hex, visibles dans l'URL de la base)
NOTION_CANDIDATURES_DB_ID=
NOTION_ARTICLES_DB_ID=
NOTION_ARTICLES_PAGE_URL=

# --- Digests emails -----------------------------------------------------
# Adresse destinataire des digests (LinkedIn, eBay). En général la sienne.
DIGEST_RECIPIENT_EMAIL=

# --- Profil candidat (skill linkedin-job-digest) ------------------------
# Zone géographique de référence pour évaluer les offres.
CANDIDATE_LOCATION=Île-de-France
